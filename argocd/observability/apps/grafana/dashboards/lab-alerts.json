  {
   "id": 5,
   "type": "stat",
   "title": "Namespaces without a dashboard",
   "description": "Namespaces running pods that groups.yaml does not list. Add them and regenerate.",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertname=\"LabNamespaceWithoutDashboard\", alertstate=\"firing\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "table",
   "title": "Needs immediate attention (critical, firing)",
   "description": "Empty is the healthy state. Every row here is broken now or puts data at risk.",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ALERTS{alertstate=\"firing\", severity=\"critical\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "alertstate": true,
       "prometheus": true,
       "openshift_io_alert_source": true,
       "endpoint": true,
       "job": true,
       "service": true,
       "instance": true,
       "container": true,
       "uid": true,
       "autosync_enabled": true,
       "Value": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "namespace": "Namespace",
       "tier": "Tier"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "Severity",
      "desc": false
     }
    ]
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "All firing alerts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ALERTS{alertstate=\"firing\", severity!=\"none\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "alertstate": true,
       "prometheus": true,
       "openshift_io_alert_source": true,
       "endpoint": true,
       "job": true,
       "service": true,
       "instance": true,
       "container": true,
       "uid": true,
       "autosync_enabled": true,
       "Value": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "namespace": "Namespace",
       "tier": "Tier"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "Severity",
      "desc": false
     }
    ]
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Firing alerts by severity",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count by (severity) (ALERTS{alertstate=\"firing\", severity!=\"none\"})",
     "legendFormat": "{{severity}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "showPoints": "never",
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  }
 ]
