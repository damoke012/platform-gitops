{
 "uid": "lab-alerts",
 "title": "Alerts overview",
 "description": "Everything firing across platform and lab rules, by severity. Critical alerts are listed first, on their own.",
 "tags": [
  "lab",
  "alerts"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Critical firing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Warning firing",
