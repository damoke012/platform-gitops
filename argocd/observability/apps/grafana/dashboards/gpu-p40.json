   "title": "GPU operator and Triton logs",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=~\"nvidia-gpu-operator|forge-inference\"} |= \"$filter\""
