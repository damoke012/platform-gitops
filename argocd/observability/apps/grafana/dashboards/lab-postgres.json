{
 "uid": "lab-postgres",
 "title": "Workload: PostgreSQL (egodeapp)",
 "description": "No postgres_exporter is deployed (it needs database credentials): connections, locks and replication are not measured. Pod, storage and log-derived signals only.",
 "tags": [
  "lab",
  "postgres"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "filter",
    "label": "Log line contains",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Postgres pod ready",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(kube_pod_status_ready{namespace=\"egodeapp\", pod=~\"postgres.*\", condition=\"true\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Restarts (24h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"egodeapp\", pod=~\"postgres.*\"}[24h]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Data PVC used",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(kubelet_volume_stats_used_bytes{namespace=\"egodeapp\"} / kubelet_volume_stats_capacity_bytes{namespace=\"egodeapp\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.92
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "FATAL/ERROR lines (1h)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({namespace=\"egodeapp\", pod=~\"postgres.*\"} |~ \"FATAL|ERROR|PANIC\" [1h]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Auth failures (1h)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({namespace=\"egodeapp\", pod=~\"postgres.*\"} |~ \"password authentication failed\" [1h]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU (cores)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"egodeapp\", pod=~\"postgres.*\", container!=\"\"}[5m]))",
     "legendFormat": "postgres"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Memory working set vs limit",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(container_memory_working_set_bytes{namespace=\"egodeapp\", pod=~\"postgres.*\", container!=\"\"})",
     "legendFormat": "working set"
    },
    {
     "refId": "B",
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"egodeapp\", pod=~\"postgres.*\", resource=\"memory\"})",
     "legendFormat": "limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "logs",
   "title": "Postgres logs",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"egodeapp\", pod=~\"postgres.*\"} |= \"$filter\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 9,
   "type": "logs",
   "title": "App logs (egodeapp)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"egodeapp\", pod!~\"postgres.*\"} |= \"$filter\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  }
 ]
}