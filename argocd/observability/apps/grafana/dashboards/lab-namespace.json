{
 "uid": "lab-namespace",
 "title": "Namespace overview",
 "description": "Pick any namespace. Pods, resources, restarts, storage, alerts and logs for it.",
 "tags": [
  "lab",
  "workloads"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "thanos"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(kube_pod_info, namespace)",
     "refId": "namespace"
    },
    "definition": "label_values(kube_pod_info, namespace)",
    "multi": false,
    "includeAll": false,
    "sort": 1,
    "regex": ""
   },
   {
    "name": "filter",
    "label": "Log line contains",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Pods running",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_pod_status_phase{namespace=\"$namespace\", phase=\"Running\"} == 1)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Pods not ready",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_pod_status_ready{namespace=\"$namespace\", condition=\"false\"} == 1) unless count(kube_pod_status_phase{namespace=\"$namespace\", phase=~\"Succeeded|Failed\"} == 1)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Pods pending",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_pod_status_phase{namespace=\"$namespace\", phase=\"Pending\"} == 1)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Restarts (1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h]))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 3
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Firing alerts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{namespace=\"$namespace\", alertstate=\"firing\", severity!=\"none\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "CPU used / requested",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m])) / sum(kube_pod_container_resource_requests{namespace=\"$namespace\", resource=\"cpu\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU by pod (cores)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Memory working set by pod",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Restarts by pod (per 15m)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[15m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 60,
      "showPoints": "never",
      "drawStyle": "bars",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "PVC usage",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kubelet_volume_stats_used_bytes{namespace=\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "used",
       "persistentvolumeclaim": "PVC"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Firing alerts",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ALERTS{namespace=\"$namespace\", alertstate=\"firing\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Logs: $namespace",
   "description": "Pod logs from lab Loki (72 h retention, app namespaces only; openshift-* not collected yet).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"$namespace\"} |= \"$filter\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 13,
   "type": "logs",
   "title": "Kubernetes events: $namespace",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{source=\"k8s-events\", namespace=\"$namespace\"}"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  }
 ]
}