{
 "uid": "lab-pod",
 "title": "Pod detail",
 "description": "Pick a namespace and pod: per-container resources against requests and limits, throttling, network, logs and events.",
 "tags": [
  "lab",
  "workloads"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "thanos"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(kube_pod_info, namespace)",
     "refId": "namespace"
    },
    "definition": "label_values(kube_pod_info, namespace)",
    "multi": false,
    "includeAll": false,
    "sort": 1,
    "regex": ""
   },
   {
    "name": "pod",
    "label": "pod",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "thanos"
    },
    "refresh": 2,
    "query": {
     "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
     "refId": "pod"
    },
    "definition": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
    "multi": false,
    "includeAll": false,
    "sort": 1,
    "regex": ""
   },
   {
    "name": "filter",
    "label": "Log line contains",
    "type": "textbox",
    "query": "",
    "current": {
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Phase Running",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(kube_pod_status_phase{namespace=\"$namespace\", pod=\"$pod\", phase=\"Running\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Ready",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(kube_pod_status_ready{namespace=\"$namespace\", pod=\"$pod\", condition=\"true\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Restarts (total)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=\"$pod\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Last OOMKilled",
   "description": "1 = a container's last termination was an OOM kill.",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", pod=\"$pod\", reason=\"OOMKilled\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Node",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (node) (kube_pod_info{namespace=\"$namespace\", pod=\"$pod\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU by container (cores), with request and limit",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"}[5m]))",
     "legendFormat": "{{container}} used"
    },
    {
     "refId": "B",
     "expr": "sum by (container) (kube_pod_container_resource_requests{namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"})",
     "legendFormat": "{{container}} request"
    },
    {
     "refId": "C",
     "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"})",
     "legendFormat": "{{container}} limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Memory by container, with request and limit",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})",
     "legendFormat": "{{container}} working set"
    },
    {
     "refId": "B",
     "expr": "sum by (container) (kube_pod_container_resource_requests{namespace=\"$namespace\", pod=\"$pod\", resource=\"memory\"})",
     "legendFormat": "{{container}} request"
    },
    {
     "refId": "C",
     "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=\"$pod\", resource=\"memory\"})",
     "legendFormat": "{{container}} limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "CPU throttled (share of periods)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (container) (increase(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"}[5m])) / sum by (container) (increase(container_cpu_cfs_periods_total{namespace=\"$namespace\", pod=\"$pod\", container!=\"\"}[5m]))",
     "legendFormat": "{{container}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Network receive",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=\"$pod\"}[5m]))",
     "legendFormat": "rx"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Network transmit",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "thanos"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\", pod=\"$pod\"}[5m]))",
     "legendFormat": "tx"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "drawStyle": "line",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "logs",
   "title": "Logs: $pod",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{namespace=\"$namespace\", pod=\"$pod\"} |= \"$filter\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Events for $pod",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{source=\"k8s-events\", namespace=\"$namespace\"} |= \"$pod\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
  }
 ]
}